# VITE_API_BASE_URL: Base URL for the future Python FastAPI backend (e.g. http://localhost:8000/api/v1)
# When empty or omitted, frontend uses client-side mock service layer for testing and demo.
VITE_API_BASE_URL=""
VITE_USE_MOCK="true"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

